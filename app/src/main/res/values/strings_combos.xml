    <string name="deck_fix_title">Slot %1$d: %2$s %3$s → %4$s</string>
    <!-- %1$s = part, %2$d = copies, %3$s = one of the deck_fix_free_* / deck_fix_none_free texts -->
    <string name="deck_fix_you_have">You have %1$s ×%2$d, %3$s.</string>
    <string name="deck_fix_none_free">all in other combos (fine, the deck only needs one)</string>
    <string name="deck_fix_free_one">free</string>
    <string name="deck_fix_free_both">both free</string>
    <string name="deck_fix_free_all">all free</string>
    <string name="deck_fix_free_some">%1$d of %2$d free</string>
    <string name="deck_fix_new_combo">Saves it as a new combo.</string>
    <!-- %1$s = record like "4W 1L", %2$d = win percentage -->
    <string name="deck_fix_already_built_record">Already built · %1$s · %2$d%%</string>
    <string name="deck_fix_already_built_unbattled">Already built, not battled yet.</string>
    <string name="deck_fix_apply">Swap into slot %1$d</string>
    <!-- %1$s = part list, e.g. "Bit Ball, Blade Dran Sword" -->
    <plurals name="deck_missing_parts">
        <item quantity="one">You own 0 of %1$s. Get it before the event, or swap it out.</item>
        <item quantity="other">You own 0 of %1$s. Get them before the event, or swap them out.</item>
    </plurals>
    <string name="deck_mix">Deck mix</string>
    <!-- %1$d = count, %2$s = type (Attack, Defense…) -->
    <string name="deck_mix_count">%1$d %2$s</string>
    <string name="deck_choose_combo">Choose a combo</string>
    <string name="deck_no_conflicts_cd">No conflicts</string>
    <string name="deck_pick_combo">Pick combo %1$d</string>
    <string name="deck_no_combos">Build some combos first.</string>
    <!-- %1$s = part names -->
    <string name="deck_repeats">Repeats %1$s</string>
    <!-- %1$s = record like "4W 1L", %2$d = win percentage -->
    <string name="deck_record_percent">%1$s · %2$d%%</string>
    <string name="deck_in_slot_cd">In this slot</string>
    <string name="deck_delete_title">Delete %1$s?</string>
    <string name="deck_delete_body">Your combos and match history stay.</string>
    <string name="combo_slot_built_in">built into %1$s</string>
</resources>
