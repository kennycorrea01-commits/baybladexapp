        <item quantity="one">%1$d conflict</item>
        <item quantity="other">%1$d conflicts</item>
    </plurals>
    <string name="deck_filled_of">%1$d of %2$d</string>
    <string name="deck_ready">Ready</string>
    <string name="deck_slot_empty">Empty</string>

    <!-- Deck editor -->
    <string name="deck_title">Deck</string>
    <!-- %1$s = "3on3" -->
    <string name="deck_edit_subtitle">%1$s deck</string>
    <string name="deck_delete_cd">Delete deck</string>
    <string name="deck_name">Deck name</string>
